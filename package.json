{
  "name": "adverteyes-trivia-racer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint src tests",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "replay": "node --experimental-strip-types scripts/replay.ts",
    "start": "node --experimental-strip-types src/server/main.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
